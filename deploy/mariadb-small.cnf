# Low-memory MariaDB settings for a 512 MB free container
[mysqld]
bind-address            = 127.0.0.1
port                    = 3306
innodb_buffer_pool_size = 32M
innodb_log_file_size    = 16M
performance_schema      = OFF
max_connections         = 30
key_buffer_size         = 8M
skip-name-resolve
